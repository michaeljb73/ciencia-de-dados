member_customer <- customers['Member']
normal_customer <- customers['Normal']
percentuais <- round(prop.table(customers) * 100, digits =2)
as.data.frame(percentuais)
percentuais$Member
percentuais['Member']
cat("",percentuais['Member'],"% dos clientes são membros(",member_customer,"), enquanto Y% são clientes normais(",normal_customer,").")
